# Local defaults. Spring Boot does not load this file automatically; pass these
# values through your IDE run configuration or local environment.
APP_COMPANY_ID=local
APP_COMPANY_NAME=Local Development
APP_TIMEZONE=Asia/Seoul

# Existing absolute directory outside Git; provider credentials are entered via setup.
DOCUMENT_SETTINGS_DIR=C:/Users/your-user/MeetingAutomation/settings
# Deployment secret: Base64 encoding of exactly 32 random bytes; never commit a value.
DOCUMENT_SETTINGS_ENCRYPTION_KEY=

OPENAI_API_KEY=
TRANSCRIPTION_MODEL=configured-transcription-model
MINUTES_MODEL=configured-minutes-model

EMAIL_PROVIDER=GMAIL_API
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REFRESH_TOKEN=
EMAIL_SENDER_ADDRESS=

NOTIFICATION_PROVIDER=SLACK
SLACK_MEETING_WEBHOOK_URL=
SLACK_ADMIN_WEBHOOK_URL=

ALLOWED_ORIGINS=http://localhost:5173
TEMP_AUDIO_DIR=C:/Users/your-user/AppData/Local/Temp/meeting-automation-audio
